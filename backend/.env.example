NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hydromind:hydromind@localhost:5432/hydromind?schema=public
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
ANOMALY_CONTINUOUS_FLOW_MINUTES=15
ANOMALY_CONTINUOUS_FLOW_THRESHOLD=0.05
ANOMALY_SPIKE_MULTIPLIER=3
ANOMALY_COOLDOWN_MINUTES=60
SENSOR_OFFLINE_MINUTES=15
